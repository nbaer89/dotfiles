{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# Re-runs whenever npm-global.txt changes. Runs on ALL Linux (NixOS included).
# hash: {{ include (joinPath .chezmoi.sourceDir "dot_config/packages/npm-global.txt") | sha256sum }}
set -euo pipefail

PKG_FILE="{{ joinPath .chezmoi.sourceDir "dot_config/packages/npm-global.txt" }}"

# Resolve npm — NixOS has it via Nix, others via Homebrew node@22
if ! command -v npm &>/dev/null; then
  if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
  fi

  export NVM_DIR="$HOME/.config/nvm"
  [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
fi

if ! command -v npm &>/dev/null; then
  echo "WARN: npm not found — skipping npm global installs"
  exit 0
fi

if [ ! -f "$PKG_FILE" ]; then
  echo "WARN: $PKG_FILE not found — skipping npm global installs"
  exit 0
fi

echo "==> Installing npm globals..."
while IFS= read -r pkg || [[ -n "$pkg" ]]; do
  [[ "$pkg" =~ ^[[:space:]]*# ]] && continue
  [[ -z "${pkg//[[:space:]]/}" ]] && continue

  echo "  -> npm install -g $pkg"
  npm install -g "$pkg"
done < "$PKG_FILE"

echo "==> npm globals up to date"
{{ end -}}
